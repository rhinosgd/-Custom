<%- include('partials/chrome-start', { title: '页面 / 博客', admin: admin }) %>
<div style="margin-bottom:1rem"><a class="btn p" href="/admin/pages/new">+ 新建页面</a></div>
<div class="card" style="padding:0;overflow:auto">
<table>
  <thead><tr><th>标题</th><th>Slug</th><th>类型</th><th>状态</th><th>操作</th></tr></thead>
  <tbody>
  <% pages.forEach(function(pg){ %>
    <tr>
      <td><b><%= pg.title %></b></td><td class="muted"><%= pg.slug %></td><td><span class="pill"><%= pg.type %></span></td><td><span class="pill <%= pg.status %>"><%= pg.status %></span></td>
      <td style="white-space:nowrap">
        <a class="btn sm" href="/admin/pages/<%= pg.id %>/edit">编辑</a>
        <form method="post" action="/admin/pages/<%= pg.id %>/delete" style="display:inline" onsubmit="return confirm('确认删除？')"><button class="btn sm d" type="submit">删</button></form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
</div>
<%- include('partials/chrome-end') %>
