<%- include('partials/chrome-start', { title: '分类管理', admin: admin }) %>
<div class="card">
  <h3 style="margin-top:0">新建 / 编辑分类</h3>
  <form method="post" action="/admin/categories" class="row" style="align-items:end">
    <div><label>名称</label><input name="name" required></div>
    <div><label>Slug</label><input name="slug" required></div>
    <div><label>排序</label><input name="sort_order" type="number" value="0"></div>
    <div><label>描述</label><input name="description"></div>
    <div><button class="btn p" type="submit">添加</button></div>
  </form>
</div>
<div class="card" style="padding:0;overflow:auto">
<table>
  <thead><tr><th>名称</th><th>Slug</th><th>描述</th><th>排序</th><th>操作</th></tr></thead>
  <tbody>
  <% categories.forEach(function(c){ %>
    <tr>
      <td><b><%= c.name %></b></td><td><%= c.slug %></td><td class="muted"><%= c.description||'' %></td><td><%= c.sort_order %></td>
      <td style="white-space:nowrap">
        <form method="post" action="/admin/categories" style="display:inline">
          <input type="hidden" name="id" value="<%= c.id %>"><input type="hidden" name="name" value="<%= c.name %>"><input type="hidden" name="slug" value="<%= c.slug %>"><input type="hidden" name="description" value="<%= c.description||'' %>"><input type="hidden" name="sort_order" value="<%= c.sort_order %>"><button class="btn sm" type="submit">改</button>
        </form>
        <form method="post" action="/admin/categories/<%= c.id %>/delete" style="display:inline" onsubmit="return confirm('删除分类？商品不会被删。')"><button class="btn sm d" type="submit">删</button></form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
</div>
<%- include('partials/chrome-end') %>
